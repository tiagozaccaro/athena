{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "shadcn": {
        "type": "local",
        "command": [
          "npx",
          "shadcn@latest",
          "mcp"
        ]
      },
      "next-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "next-devtools-mcp@latest"
        ]
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--headless",
          "--isolated",
          "--output-dir",
          ".playwright-mcp"
        ]
      },
      "context7": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@upstash/context7-mcp@latest"
        ]
      }
    }
  }
}
