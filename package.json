{
  "name": "athena",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "gen:api": "cd apps/server && uv run athena openapi --output ../../packages/api-client/openapi.json && cd ../.. && pnpm --filter @workspace/api-client generate",
    "gen:theme": "node scripts/gen-theme-css.mjs"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "license": "Apache-2.0"
}
