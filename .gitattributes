# Normalize line endings: LF in the repo and working tree, so shell scripts and
# generated files behave the same on Linux, macOS and Windows.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary

# Recorded tool output: keep the exact bytes (CRLF, bare CRs from progress spinners).
apps/server/tests/fixtures/** -text
