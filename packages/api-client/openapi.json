{
  "openapi": "3.1.0",
  "info": {
    "title": "Athena",
    "version": "0.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/system/info": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "System Info",
        "operationId": "getSystemInfo",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemInfo"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "Health"
      },
      "SystemInfo": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version"
          },
          "os": {
            "type": "string",
            "enum": [
              "linux",
              "darwin",
              "windows"
            ],
            "title": "Os"
          },
          "os_version": {
            "type": "string",
            "title": "Os Version"
          },
          "arch": {
            "type": "string",
            "title": "Arch"
          },
          "hostname": {
            "type": "string",
            "title": "Hostname"
          },
          "python": {
            "type": "string",
            "title": "Python"
          }
        },
        "type": "object",
        "required": [
          "version",
          "os",
          "os_version",
          "arch",
          "hostname",
          "python"
        ],
        "title": "SystemInfo"
      }
    }
  }
}
